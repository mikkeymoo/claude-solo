{
  "model": "claude-opus-4-8[1m]",
  "effortLevel": "medium",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git stash list*)",
      "Bash(git remote *)",
      "Bash(rtk *)",
      "Bash(ls *)",
      "Bash(cat package.json)",
      "Bash(cat pyproject.toml)",
      "Bash(node --version)",
      "Bash(python --version)",
      "Bash(npm --version)",
      "Bash(pnpm --version)"
    ],
    "deny": []
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".next",
      "dist",
      "build",
      "__pycache__",
      ".venv"
    ]
  }
}
