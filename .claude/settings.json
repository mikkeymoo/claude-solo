{
  "model": "claude-opus-4-8",
  "effortLevel": "medium",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git stash list*)",
      "Bash(git remote *)",
      "Bash(rtk *)",
      "Bash(ls *)",
      "Bash(cat package.json)",
      "Bash(cat pyproject.toml)",
      "Bash(node --version)",
      "Bash(python --version)",
      "Bash(npm --version)",
      "Bash(pnpm --version)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(npm publish *)",
      "Bash(cargo publish *)",
      "Bash(twine upload *)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(curl * | sh)",
      "Bash(dd if=*)",
      "Bash(chmod -R 777 *)",
      "Bash(mkfs.*)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Write(**/secrets/**)",
      "Read(**/credentials/**)",
      "Edit(**/credentials/**)",
      "Write(**/credentials/**)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Read(**/id_rsa*)",
      "Edit(**/id_rsa*)",
      "Write(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Edit(**/id_ed25519*)",
      "Write(**/id_ed25519*)"
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".next",
      "dist",
      "build",
      "__pycache__",
      ".venv"
    ]
  }
}
